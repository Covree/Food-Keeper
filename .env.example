# Copie para .env (opcional: o compose já tem valores padrão para tudo).

# Portas expostas no seu computador
APP_PORT=8080
FRONTEND_PORT=3000
MYSQL_HOST_PORT=3307

# Banco
MYSQL_DATABASE=food_keeper
DB_PASSWORD=root

# JWT (mínimo 32 caracteres)
JWT_SECRET=troque-esta-chave-por-uma-chave-secreta-com-pelo-menos-32-caracteres
JWT_EXPIRATION_MS=86400000

# Admin inicial
SEED_ADMIN_ENABLED=true
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@foodkeeper.local
SEED_ADMIN_PASSWORD=TroqueEstaSenha123!
